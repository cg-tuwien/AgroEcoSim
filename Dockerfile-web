FROM node:24-alpine AS build

ARG BACKEND

WORKDIR /app

COPY ThreeFrontend/package.json ThreeFrontend/package-lock.json ./

RUN npm ci --include=dev

COPY ThreeFrontend/ ./

RUN echo "export const BackendURI = \"${BACKEND}\";" > src/config.ts

RUN NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production ./node_modules/.bin/preact build --no-prerender


FROM node:24-alpine AS final

WORKDIR /app

RUN npm install --global --no-audit --no-fund sirv-cli@3.0.1

COPY --from=build /app/build/ ./

USER node

EXPOSE 8080

ENTRYPOINT ["sirv", ".", "--cors", "--single", "--host", "0.0.0.0", "--port", "8080"]