# Legacy build environment: migrate this separately after fixing dependencies.
FROM node:24-alpine AS build

WORKDIR /app

COPY ThreeFrontend/ ./

# package.json and package-lock.json must contain the compatible pins.
RUN npm ci --include=dev

ARG BACKEND

# Generate a valid TypeScript string literal, including proper escaping.
RUN node -e 'require("node:fs").writeFileSync( \
    "src/config.ts", \
    "export const BackendURI = " + \
    JSON.stringify(process.env.BACKEND || "") + ";\n" \
    );'

# Use the locally installed CLI; preserve your existing OpenSSL workaround.
RUN NODE_OPTIONS=--openssl-legacy-provider \
    ./node_modules/.bin/preact build --no-prerender


FROM node:24-alpine AS final

ENV NODE_ENV=production

# Install the server outside the directory containing public assets.
RUN npm install --global --no-audit --no-fund sirv-cli@3.0.1 \
    && npm cache clean --force

WORKDIR /app

COPY --from=build /app/build/ ./

USER node

EXPOSE 8080

ENTRYPOINT ["sirv", ".", "--cors", "--single", "--host", "0.0.0.0", "--port", "8080"]