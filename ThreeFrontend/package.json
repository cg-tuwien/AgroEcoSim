{
  "private": true,
  "name": "ThreeFrontend",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider preact build --no-prerender",
    "serve": "sirv build --cors --single",
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider preact watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:full": "npm run build && jest"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "extends": [
      "preact",
      "plugin:@typescript-eslint/recommended"
    ],
    "ignorePatterns": [
      "build/"
    ],
    "overrides": [
      {
        "files": [
          "src/render/core/**/*.ts",
          "src/render/core/**/*.tsx",
          "src/render/webgpu/**/*.ts",
          "src/render/webgpu/**/*.tsx"
        ],
        "rules": {
          "no-restricted-imports": [
            "error",
            {
              "patterns": [
                {
                  "group": [
                    "three",
                    "three/*"
                  ],
                  "message": "src/render/core and src/render/webgpu must stay renderer-neutral. Three.js belongs in src/render/three. The build transpiles with babel and never type-checks, so this lint rule is the only automated guard against the boundary eroding."
                }
              ]
            }
          ]
        }
      }
    ],
    "rules": {
      "no-unused-expressions": [
        "error",
        {
          "allowShortCircuit": false,
          "allowTernary": false,
          "allowTaggedTemplates": false
        }
      ],
      "@typescript-eslint/no-unused-expressions": "off"
    }
  },
  "dependencies": {
    "@microsoft/signalr": "^7.0.5",
    "@preact/signals": "^1.1.3",
    "@types/three": "^0.152.1",
    "@webgpu/types": "^0.1.70",
    "preact": "^10.15.1",
    "preact-render-to-string": "^5.2.6",
    "preact-router": "^3.2.1",
    "tailwindcss": "^3.3.2",
    "three": "^0.152.2",
    "tw-elements": "^1.0.0-beta2",
    "wired-elements": "^3.0.0-rc.6"
  },
  "devDependencies": {
    "@types/enzyme": "^3.10.13",
    "@types/jest": "^27.5.2",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "baseline-browser-mapping": "^2.11.20",
    "cross-env": "^7.0.3",
    "enzyme": "^3.11.0",
    "enzyme-adapter-preact-pure": "^4.1.0",
    "eslint": "^8.42.0",
    "eslint-config-preact": "^1.3.0",
    "jest": "^27.5.1",
    "jest-preset-preact": "^4.0.5",
    "preact-cli": "^3.4.5",
    "sirv-cli": "^2.0.2",
    "typescript": "^4.9.5"
  },
  "jest": {
    "preset": "jest-preset-preact",
    "setupFiles": [
      "<rootDir>/tests/__mocks__/browserMocks.ts",
      "<rootDir>/tests/__mocks__/setupTests.ts"
    ]
  }
}
