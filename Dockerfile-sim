#https://varhowto.com/install-miniconda-ubuntu-20-04/
FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS publish
COPY . .
#fix https://github.com/dotnet/dotnet-docker/issues/2470
ENV COMPlus_EnableDiagnostics=0
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV ASPNETCORE_ENVIRONMENT='Production'

WORKDIR AgroServer

ARG BACKEND
RUN dotnet restore --runtime alpine-x64
#--disable-parallel

RUN dotnet publish \
    --configuration Release \
    -p:Platform=x64 \
    --framework=net8.0 \
    --nologo \
    --runtime alpine-x64 \
    --no-self-contained \
    -p:PublishReadyToRun=true \
    -p:PublishReadyToRunShowWarnings=true \
    -p:WarningLevel=0 \
    #-p:PublishTrimmed=true \
    --output /app/ \
    /clp:ErrorsOnly
#--verbosity detailed

FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS final
WORKDIR /app
ENV COMPlus_EnableDiagnostics=0
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV ASPNETCORE_ENVIRONMENT='Production'
ENV AGRO_HOSTNAME=${BACKEND}
#only copy the published app folder into the final image, everything else (the whole src) is ignored
COPY --from=publish /app .

RUN apk update && apk add --no-cache ca-certificates && apk --no-cache add tzdata && apk upgrade -U --no-cache && rm -rf /var/cache/apk/*
#COPY --from=publish harden.sh .
#RUN chmod +x harden.sh && sh harden.sh && rm harden.sh
#USER user:user

RUN addgroup -g 61000 docker && adduser -g 61000 -H -D -s /bin/false -u 61000 docker -G docker

#Where the run store keeps every simulation frame.
#
#It cannot live under /app: that is copied in as root and the container then drops to an
#unprivileged user, so the store fails to create its own root, disables itself, and the whole of
#the server-side persistence silently does nothing in the deployed image while working perfectly
#in development. Give it a directory this user owns, and declare it a volume so a container
#restart does not take the runs with it - one two-month run at production plant count is ~17 GB,
#which has no business in the writable layer either.
RUN mkdir -p /data/runstore && chown -R 61000:61000 /data
ENV AGRO_RunStoreRoot=/data/runstore

#Listen on every interface, not just loopback.
#
#An explicit Listen call in ConfigureKestrel overrides UseUrls and ASPNETCORE_URLS, so without this
#the server binds 127.0.0.1 inside the container's own network namespace and NOTHING outside the
#container can reach it, however the port is published. The default stays loopback because the API
#has no authentication; a container is the place that opts in.
ENV AGRO_ListenAnyIP=true
VOLUME /data

USER docker

#does nothing, just documents the exposed port
EXPOSE 7215
ENTRYPOINT ["./AgroServer"]