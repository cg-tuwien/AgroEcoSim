<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <ProjectReference Include="..\AgentsSystem\AgentsSystem.csproj" />
    <ProjectReference Include="..\Agro\Agro.csproj" />
    <ProjectReference Include="..\Utils\Utils.csproj" />
    <ProjectReference Include="..\FacadeJsonImport\FacadeJsonImport.csproj" />
  </ItemGroup>


  <Target Name="GenerateSpeciesTypescript" AfterTargets="CoreCompile">
    <Message Importance="high" Text="Generating Species.generated.ts from SpeciesSettings.cs" />

    <Exec Command="dotnet run --framework $(TargetFramework) --project &quot;$(MSBuildProjectDirectory)/../SchemeGenerator/SchemeGenerator.csproj&quot; -- &quot;$(MSBuildProjectDirectory)/../Agro/SpeciesSettings.cs&quot; &quot;$(MSBuildProjectDirectory)/../ThreeFrontend/src/helpers/Species.gen.ts&quot; &quot;$(MSBuildProjectDirectory)/../ThreeFrontend/src/components/hud/Species.gen.tsx&quot;" />
  </Target>
</Project>
